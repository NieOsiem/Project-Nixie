{
  "name": "project-nixie",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Top-down cyberpunk city generator for Foundry VTT",
  "scripts": {
    "build": "node node_modules/vite/bin/vite.js build",
    "watch": "NIXIE_WATCH=1 node node_modules/vite/bin/vite.js build --watch",
    "test": "node node_modules/vitest/vitest.mjs run --project fast",
    "test:acceptance": "node node_modules/vitest/vitest.mjs run --project acceptance",
    "test:watch": "node node_modules/vitest/vitest.mjs --project fast",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "earcut": "^3.2.3",
    "polygon-clipping": "^0.15.7"
  }
}
